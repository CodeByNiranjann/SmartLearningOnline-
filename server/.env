# ==============================================================================
# SMART LEARNING PLATFORM — SERVER ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Server Network Port (Default: 5000)
PORT=5000

# Server Node Environment (development | test | production)
NODE_ENV=development

# MongoDB Connection String
# Local example: mongodb://127.0.0.1:27017/online-learning
# Docker example: mongodb://mongo:27017/online-learning
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/online-learning?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/online-learning

# JWT Secret Key (Use a cryptographically secure random string with 32+ characters in production)
JWT_SECRET=super_secret_slp_learning_jwt_key_2026

# Allowed Frontend Client Origin for CORS (e.g., http://localhost:5173 or https://learnhub.yourdomain.com)
CLIENT_URL=http://localhost:5173
